<script setup lang="ts">
/**
 * Dashboard View — Protected page showing application stats
 *
 * API: GET /api/dashboard/stats → { users, uptime, requestsPerSecond }
 */
import { ref, onMounted } from 'vue'
import { api, ApiError } from '@/lib/api'
import { useAuthStore } from '@/stores/auth'
import type { DashboardStats } from '@/types/api'

const auth = useAuthStore()

const stats = ref<DashboardStats>({ users: 0, uptime: 'Just started', requestsPerSecond: '0' })
const loading = ref(true)
const loadError = ref(false)

const alertMessage = ref('')
const showAlert = ref(false)

onMounted(async () => {
  try {
    const { data } = await api.get<DashboardStats>('/api/dashboard/stats')
    stats.value = data
  } catch (error) {
    loadError.value = true
    alertMessage.value = error instanceof ApiError ? error.data?.message ?? error.message : 'Could not load dashboard stats.'
    showAlert.value = true
  } finally {
    loading.value = false
  }
})
</script>

<template>
  <div class="p-4">
    <header class="mb-5">
      <h1 class="display-6 fw-bold">
        Welcome back<span v-if="auth.userName">, {{ auth.userName }}</span>!
      </h1>
      <p class="text-muted">Here's a quick overview of your application.</p>
    </header>

    <VibeAlert v-model="showAlert" variant="danger" :message="alertMessage" dismissable />

    <VibeRow class="g-4">
      <VibeCol md="4">
        <VibeCard>
          <template #body>
            <div class="text-center">
              <VibeSpinner v-if="loading" />
              <p v-else-if="loadError" class="text-danger mb-0">Unavailable</p>
              <template v-else>
                <h2 class="display-5 fw-bold text-primary">{{ stats.users }}</h2>
                <p class="text-muted mb-0">Total Users</p>
              </template>
            </div>
          </template>
        </VibeCard>
      </VibeCol>
      <VibeCol md="4">
        <VibeCard>
          <template #body>
            <div class="text-center">
              <VibeSpinner v-if="loading" />
              <p v-else-if="loadError" class="text-danger mb-0">Unavailable</p>
              <template v-else>
                <h2 class="display-5 fw-bold text-success">{{ stats.uptime }}</h2>
                <p class="text-muted mb-0">Uptime</p>
              </template>
            </div>
          </template>
        </VibeCard>
      </VibeCol>
      <VibeCol md="4">
        <VibeCard>
          <template #body>
            <div class="text-center">
              <VibeSpinner v-if="loading" />
              <p v-else-if="loadError" class="text-danger mb-0">Unavailable</p>
              <template v-else>
                <h2 class="display-5 fw-bold text-warning">
                  {{ stats.requestsPerSecond }} <small class="fs-5">req/s</small>
                </h2>
                <p class="text-muted mb-0">Performance</p>
              </template>
            </div>
          </template>
        </VibeCard>
      </VibeCol>
    </VibeRow>
  </div>
</template>
