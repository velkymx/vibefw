<script setup lang="ts">
/**
 * Login View — Authenticates users against the VibeFW API
 *
 * API contract:
 *   POST /api/auth/login
 *   Body:    { email: string, password: string }
 *   Success: { user: User, token: string }         → 200
 *   Invalid: { message: string, errors: object }   → 422 (validation)
 *   Failed:  { message: string }                   → 401 (bad credentials)
 *
 * On success, the token is saved to localStorage and the user is
 * redirected to /dashboard. The router guard (see router/index.ts)
 * prevents authenticated users from revisiting this page.
 *
 * Validation errors from the server (422) are mapped directly to
 * VibeFormInput's :validation-state and :validation-message props,
 * giving instant per-field feedback without any extra wiring.
 */
import { ref } from 'vue'
import { useRouter } from 'vue-router'
import axios from 'axios'

const router = useRouter()

// Form state
const form = ref({ email: '', password: '' })
const loading = ref(false)

// Per-field validation errors from the server (422 response)
const errors = ref<Record<string, string>>({})

// General error alert (non-field errors like 401)
const alertMessage = ref('')
const showAlert = ref(false)

const handleLogin = async () => {
  loading.value = true
  errors.value = {}
  alertMessage.value = ''
  showAlert.value = false

  try {
    const response = await axios.post('/api/auth/login', form.value)

    // Store the Bearer token — used by authHeaders() throughout the app
    localStorage.setItem('token', response.data.token)

    // Navigate to the protected dashboard
    router.push('/dashboard')
  } catch (error: any) {
    if (error.response?.status === 422) {
      // Map server validation errors to form fields
      errors.value = error.response.data.errors ?? {}
    } else {
      // Show a general error alert (bad credentials, server error, etc.)
      alertMessage.value = error.response?.data?.message ?? 'Authentication failed. Please try again.'
      showAlert.value = true
    }
  } finally {
    loading.value = false
  }
}
</script>

<template>
  <div class="auth-container d-flex align-items-center justify-content-center">
    <div class="auth-card">
      <VibeCard class="shadow-sm">
        <template #body>
          <h4 class="fw-bold mb-1">Welcome Back</h4>
          <p class="text-muted mb-4">Log in to your account</p>

          <!-- General error alert (non-field errors) -->
          <VibeAlert v-model="showAlert" variant="danger" :message="alertMessage" dismissable />

          <form @submit.prevent="handleLogin">
            <!-- Email field — :validation-state maps 422 errors automatically -->
            <VibeFormGroup label="Email Address">
              <VibeFormInput
                v-model="form.email"
                type="email"
                placeholder="you@example.com"
                :validation-state="errors.email ? 'invalid' : null"
                :validation-message="errors.email"
              />
            </VibeFormGroup>

            <!-- Password field -->
            <VibeFormGroup label="Password" class="mt-3">
              <VibeFormInput
                v-model="form.password"
                type="password"
                placeholder="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;"
                :validation-state="errors.password ? 'invalid' : null"
                :validation-message="errors.password"
              />
            </VibeFormGroup>

            <!-- Submit button — :loading shows a spinner and disables the button -->
            <VibeButton type="submit" variant="primary" class="w-100 mt-4" :loading="loading">
              Log In
            </VibeButton>

            <div class="mt-3 text-center">
              <router-link to="/register" class="text-decoration-none small">
                Don't have an account? Register
              </router-link>
            </div>
          </form>
        </template>
      </VibeCard>
    </div>
  </div>
</template>

<style scoped>
.auth-container {
  min-height: 100vh;
  background-color: var(--bs-body-bg);
}
.auth-card {
  width: 100%;
  max-width: 400px;
}
</style>
