/**
 * VibeFW SPA — Application Entry Point
 *
 * Bootstraps Vue 3 with Pinia, Router, and VibeUI.
 * Auth state is managed by the Pinia auth store (@/stores/auth).
 * API calls use the fetch wrapper from @/lib/api.
 */
import { createApp } from 'vue'
import { createPinia } from 'pinia'
import App from './App.vue'
import router from './router'
import VibeUI from '@velkymx/vibeui'

const app = createApp(App)

app.use(createPinia())
app.use(router)
app.use(VibeUI)

app.mount('#app')
