</script>

<template>
  <div id="app-root">
    <router-view />
  </div>
</template>

<style lang="scss">
@import "bootstrap/scss/bootstrap";
@import "bootstrap-icons/font/bootstrap-icons.css";
@import "@velkymx/vibeui/dist/style.css";
@import "quill/dist/quill.snow.css";

#app-root {
  min-height: 100vh;
}
</style>
