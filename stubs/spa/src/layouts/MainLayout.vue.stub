<script setup lang="ts">
/**
 * MainLayout — Authenticated shell layout
 *
 * Wraps all authenticated pages with a collapsible sidebar and top header bar.
 * User state comes from the Pinia auth store, not direct API calls.
 */
import { ref, onMounted } from 'vue'
import { useRouter } from 'vue-router'
import { useAuthStore } from '@/stores/auth'
import { useColorMode } from '@velkymx/vibeui'

const router = useRouter()
const auth = useAuthStore()
const { isDark, toggle: toggleDarkMode } = useColorMode()

const isSidebarOpen = ref(true)

const handleLogout = async () => {
  await auth.logout()
  router.push('/login')
}

const toggleSidebar = () => {
  isSidebarOpen.value = !isSidebarOpen.value
}

onMounted(() => {
  auth.fetchUser()
})
</script>

<template>
  <div class="app-wrapper" :class="{ 'sidebar-closed': !isSidebarOpen }">
    <!-- Sidebar -->
    <aside class="app-sidebar shadow-sm">
      <div class="sidebar-header p-3 d-flex align-items-center justify-content-between">
        <span class="fw-bold fs-4">Vibe<span class="text-primary">FW</span></span>
        <VibeButton size="sm" variant="light" class="d-lg-none" @click="toggleSidebar">
          <VibeIcon icon="x-lg" />
        </VibeButton>
      </div>

      <VibeNav vertical class="sidebar-nav p-2 flex-grow-1">
        <router-link to="/dashboard" class="nav-link py-2 px-3 rounded mb-1" active-class="active">
          <VibeIcon icon="speedometer2" custom-class="me-2" /> Dashboard
        </router-link>
        <router-link to="/profile" class="nav-link py-2 px-3 rounded mb-1" active-class="active">
          <VibeIcon icon="person" custom-class="me-2" /> Profile
        </router-link>

        <div class="border-top my-2"></div>

        <VibeButton
          variant="link"
          class="nav-link w-100 text-start py-2 px-3 rounded text-danger"
          @click="handleLogout"
        >
          <VibeIcon icon="box-arrow-right" custom-class="me-2" /> Logout
        </VibeButton>
      </VibeNav>

      <div class="sidebar-footer p-3 border-top" v-if="auth.user">
        <div class="d-flex align-items-center">
          <div class="user-avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0">
            {{ auth.user.name?.charAt(0)?.toUpperCase() ?? '?' }}
          </div>
          <div class="overflow-hidden">
            <div class="fw-semibold text-truncate">{{ auth.user.name ?? auth.user.email }}</div>
            <div class="small text-muted text-truncate">{{ auth.user.email }}</div>
          </div>
        </div>
      </div>
    </aside>

    <!-- Main content area -->
    <main class="app-main d-flex flex-column">
      <header class="app-header shadow-sm p-3 d-flex align-items-center">
        <VibeButton size="sm" variant="light" class="me-3" @click="toggleSidebar">
          <VibeIcon icon="list" />
        </VibeButton>
        <VibeBreadcrumb :items="[
          { text: 'Home', href: '/' },
          { text: String(router.currentRoute.value.name ?? ''), active: true }
        ]" />
        <div class="ms-auto d-flex align-items-center gap-2">
          <VibeButton
            size="sm"
            variant="light"
            @click="toggleDarkMode"
            :title="isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode'"
          >
            <VibeIcon :icon="isDark ? 'sun-fill' : 'moon-fill'" />
          </VibeButton>
          <span v-if="auth.user" class="small text-muted d-none d-lg-inline">{{ auth.userName }}</span>
        </div>
      </header>

      <section class="app-content flex-grow-1 overflow-auto bg-body-secondary">
        <router-view />
      </section>
    </main>
  </div>
</template>

<style scoped>
.app-wrapper {
  display: flex;
  height: 100vh;
  width: 100vw;
  overflow: hidden;
}

.app-sidebar {
  width: 260px;
  background-color: var(--bs-body-bg);
  display: flex;
  flex-direction: column;
  transition: margin-left 0.3s ease;
  z-index: 1000;
}

.app-sidebar .nav-link {
  color: var(--bs-body-color);
  text-decoration: none;
  transition: background-color 0.2s;
  cursor: pointer;
}

.app-sidebar .nav-link:hover {
  background-color: var(--bs-tertiary-bg);
}

.app-sidebar .nav-link.active {
  background-color: var(--bs-primary);
  color: #fff;
}

.app-header {
  background-color: var(--bs-body-bg);
}

.app-main {
  flex-grow: 1;
  overflow: hidden;
}

.user-avatar {
  width: 38px;
  height: 38px;
  font-size: 1rem;
}

.sidebar-closed .app-sidebar {
  margin-left: -260px;
}

@media (max-width: 991.98px) {
  .app-sidebar {
    position: fixed;
    height: 100%;
  }
}
</style>
