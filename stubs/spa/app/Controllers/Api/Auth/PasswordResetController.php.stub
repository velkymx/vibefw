<?php

declare(strict_types=1);

namespace App\Controllers\Api\Auth;

use Fw\Core\Controller;
use Fw\Core\Request;
use Fw\Core\Response;
use App\Models\User;
use Fw\Auth\PasswordReset;
use Fw\Support\Hash;

/**
 * PasswordResetController handles the "forgot password" and "reset password" lifecycle.
 * 
 * VibeFW v2.0 Pattern:
 * 1. Leverages Fw\Auth\PasswordReset for token management.
 * 2. Returns structured JSON for SPA to handle error/success states.
 */
final class PasswordResetController extends Controller
{
    /**
     * Send a reset link to the given user.
     * 
     * In a production app, you would dispatch a Job to send an email here.
     */
    public function forgotPassword(Request $request): Response
    {
        $validation = $this->validate($request, [
            'email' => 'required|email',
        ]);

        if ($validation->isErr()) {
            return $this->json([
                'message' => 'Validation failed', 
                'errors' => $validation->getError()
            ], 422);
        }

        $email = $validation->getValue()['email'];
        $user = User::where('email', $email)->first()->unwrapOr(null);

        if ($user) {
            $token = PasswordReset::createToken($email);
            
            // TODO: Dispatch a job to send the email with the token link
            // For now, we return success to the SPA.
        }

        return $this->json(['message' => 'Reset link sent if email exists']);
    }

    /**
     * Reset the user's password.
     */
    public function resetPassword(Request $request): Response
    {
        $validation = $this->validate($request, [
            'token' => 'required',
            'email' => 'required|email',
            'password' => 'required|min:8|confirmed',
        ]);

        if ($validation->isErr()) {
            return $this->json([
                'message' => 'Validation failed', 
                'errors' => $validation->getError()
            ], 422);
        }

        $data = $validation->getValue();
        $reset = PasswordReset::findByToken($data['token']);

        if (!$reset || $reset['email'] !== $data['email']) {
            return $this->json(['message' => 'Invalid or expired token'], 422);
        }

        $user = User::where('email', $data['email'])->first()->unwrapOr(null);
        if ($user) {
            $user->fill([
                'password' => Hash::make($data['password']),
            ])->save();

            PasswordReset::deleteToken($data['token']);

            return $this->json(['message' => 'Password reset successfully']);
        }

        return $this->json(['message' => 'User not found'], 404);
    }
}
