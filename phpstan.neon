includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src
        - app
    excludePaths:
        - src/Console/Commands  # CLI commands have dynamic patterns

    # Treat phpdoc types as authoritative
    treatPhpDocTypesAsCertain: false

    # Report unused parameters
    reportUnmatchedIgnoredErrors: false

    # PHP 8.4 features
    phpVersion: 80400

    # Ignore patterns for framework magic
    ignoreErrors:
        # Option/Result monad unwrapping
        - '#Call to method unwrap\(\) on Fw\\Types\\Option<.+>#'

        # Dynamic model properties (handled by __get/__set)
        - '#Access to an undefined property App\\Models\\.+::\$[a-zA-Z]+#'

        # Auth/Gate/TokenGuard use Model base type but call model-specific methods dynamically
        - '#Call to an undefined method Fw\\Model\\Model::(findByEmail|verifyPassword|findToken|forUser|touchLastUsed|isExpired|can|user)\(\)#'
        - '#Call to an undefined static method Fw\\Model\\Model::(findByEmail|findToken|forUser)\(\)#'
        - '#Access to an undefined property Fw\\Model\\Model::\$(id|remember_token|abilities|name|expires_at|user_id|last_used_at|token)#'

        # PDO parameter binding accepts mixed
        - '#Parameter \#2 .+ of method PDOStatement::execute\(\) expects array<int\|string, mixed>#'

    # Parallel processing
    parallel:
        maximumNumberOfProcesses: 4
